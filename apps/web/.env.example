# Copy to .env.local to point a local build at a different Supabase project.
# These are public values that ship in the browser bundle. Never add a service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
# Product name shown before a business brand loads.
VITE_APP_NAME=BoutiquePOS
# Public key licence tokens are checked against (JSON JWK).
VITE_LICENCE_PUBLIC_KEY={"kty":"EC","crv":"P-256","x":"...","y":"..."}
